---
interface Props {
	alt?: string;
	size?: number;
}

const { alt = 'Kanada Kurniawan', size = 256 } = Astro.props;
---

<img
	class="avatar"
	src={import.meta.env.BASE_URL + 'images/kanada-kurniawan.webp'}
	alt={alt}
	width={200}
	height={200}
	style={`width: ${size}px; height: ${size}px;`}
/>

<style>
	.avatar {
		display: block;
		object-fit: cover;
		border-radius: 50%;
		border: 3px solid var(--border);
		box-shadow: 0 4px 18px rgb(0 0 0 / 0.12);
	}
</style>