---
interface Props {
	alt?: string;
	size?: number;
}

const { alt = 'Kanada Kurniawan', size = 256 } = Astro.props;
---

<div
	class="avatar-ring"
	style={`--size: ${size}px;`}
>
	<img
		class="avatar"
		src={import.meta.env.BASE_URL + 'images/kanada-kurniawan.webp'}
		alt={alt}
		width={200}
		height={200}
		loading="lazy"
	/>
</div>

<style>
	.avatar-ring {
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		padding: 4px;
		background: linear-gradient(140deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #f59e0b) 70%, transparent);
		box-shadow: 0 10px 32px -14px rgb(var(--accent-glow) / 0.55);
	}
	.avatar {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		border: 3px solid var(--bg);
	}
</style>