---
import { siteConfig } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<p>© {year} {siteConfig.author}. Research on artificial intelligence and meteorology.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		margin-top: 4rem;
		padding-block: 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>