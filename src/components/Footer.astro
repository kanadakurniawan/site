---
import { siteConfig } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<p class="footer-note">
			© {year} {siteConfig.author}
			<span class="dot" aria-hidden="true">·</span>
			AI × Meteorology
		</p>
		<p class="footer-links">
			<a href={import.meta.env.BASE_URL + 'rss.xml'}>RSS</a>
			<a href={import.meta.env.BASE_URL + 'blog/'}>Blog</a>
			<a href={import.meta.env.BASE_URL + 'publications/'}>Publications</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		padding-block: 2rem;
		border-top: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 70%, var(--surface-2));
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}
	.footer-note {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.footer-note .dot {
		margin-inline: 0.5rem;
		color: var(--border-strong);
	}
	.footer-links {
		display: flex;
		gap: 1.1rem;
		margin: 0;
		font-size: 0.9rem;
	}
	.footer-links a {
		color: var(--muted);
	}
	.footer-links a:hover {
		color: var(--accent-strong);
		text-decoration: none;
	}
</style>