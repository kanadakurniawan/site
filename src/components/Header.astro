---
import { siteConfig } from '../config';
---

<header class="site-header">
	<div class="container nav-wrap">
		<a class="site-logo" href="/">{siteConfig.title}</a>
		<nav aria-label="Main navigation">
			<ul>
				{
					siteConfig.nav.map((item) => (
						<li><a href={item.href}>{item.title}</a></li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}
	.nav-wrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding-block: 0.9rem;
	}
	.site-logo {
		font-weight: 700;
		font-size: 1.1rem;
	}
	nav ul {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 1.1rem;
	}
	nav a {
		color: var(--muted);
		font-size: 0.95rem;
	}
	nav a:hover {
		color: var(--text);
	}
</style>