---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div class="bg-background grad-line relative flex w-full items-baseline justify-between py-4 sm:items-center sm:py-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="absolute flex items-center gap-2 py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      <img
        src="/images/kanada-kurniawan.webp"
        alt={site.title}
        width="36"
        height="36"
        loading="eager"
        class="grad-ring size-9 rounded-full object-cover"
      />
      {site.title}
    </a>
    <button
      id="menu-btn"
      class="focus-outline relative z-[60] ms-auto flex size-10 items-center justify-center rounded-md p-2"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-items"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <IconX id="close-icon" class="hidden size-6" />
      <IconMenuDeep id="menu-icon" class="size-6" />
    </button>
    <nav
      id="nav-menu"
      class="fixed inset-0 z-50 hidden place-items-center bg-background/95 backdrop-blur-sm data-[open=true]:grid"
      data-open="false"
    >
      <ul
        id="menu-items"
        class="m-0 w-full list-none place-items-center gap-2 p-0 text-center [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-2.5 [&>li>a]:text-2xl [&>li>a]:font-semibold [&>li>a]:no-underline [&>li>a]:hover:text-accent"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={{ "active-nav": isActive("/tags") }}
          >
            {t.nav.tags}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "publications")}
            class:list={{ "active-nav": isActive("/publications") }}
          >
            Publications
          </a>
        </li>
        <li class="group/apps relative flex flex-col items-center">
          <button
            id="apps-toggle"
            type="button"
            class="focus-outline inline-flex items-center justify-center gap-1 px-4 py-2.5 text-2xl font-semibold no-underline hover:text-accent"
            aria-expanded="false"
            aria-controls="apps-submenu"
          >
            {t.nav.apps}
            <svg
              class="apps-chevron size-5 transition-transform duration-200"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <ul
            id="apps-submenu"
            class="m-0 hidden flex-col items-center gap-1 p-0 no-underline group-hover/apps:flex"
          >
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "apps")}
                class:list={["no-underline", { "active-nav": isActive("/apps") }]}
              >
                All apps
              </a>
            </li>
            <li>
              <a
                href="https://model.kanadakurniawan.com"
                rel="noopener"
                target="_blank"
                class="no-underline"
              >
                Model
              </a>
            </li>
          </ul>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={{ "active-nav": isActive("/archives") }}
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
        {
          features.search !== false && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={{ "active-nav": isActive("/search") }}
              >
                {t.nav.search}
              </a>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="mt-4 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:[&>svg]:stroke-accent relative size-12 p-4"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const navMenu = document.querySelector<HTMLElement>("#nav-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !navMenu || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    const setOpen = (open: boolean) => {
      navMenu.dataset.open = String(open);
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
    };

    menuBtn.addEventListener("click", () => {
      setOpen(navMenu.dataset.open !== "true");
    });

    navMenu.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => setOpen(false))
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  function toggleAppsSubmenu() {
    const appsToggle = document.querySelector<HTMLButtonElement>("#apps-toggle");
    const submenu = document.querySelector<HTMLElement>("#apps-submenu");
    const chevron = document.querySelector<SVGElement>(".apps-chevron");

    if (!appsToggle || !submenu || !chevron) return;

    appsToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = appsToggle.getAttribute("aria-expanded") === "true";
      appsToggle.setAttribute("aria-expanded", open ? "false" : "true");
      submenu.classList.toggle("hidden", open);
      submenu.classList.toggle("flex", !open);
      chevron.style.transform = open ? "rotate(0deg)" : "rotate(180deg)";
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  toggleAppsSubmenu();
  document.addEventListener("astro:after-swap", toggleAppsSubmenu);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
