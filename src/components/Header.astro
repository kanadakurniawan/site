---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div class="bg-background grad-line relative flex w-full items-baseline justify-between py-4 sm:items-center sm:py-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="absolute flex items-center gap-3 py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      <img
        src="/images/kanada-kurniawan.webp"
        alt={site.title}
        width="36"
        height="36"
        loading="eager"
        class="grad-ring size-9 rounded-full object-cover"
      />
      {site.title}
    </a>
    <button
      id="menu-btn"
      class="focus-outline relative z-[60] ms-auto flex size-10 items-center justify-center rounded-md p-2"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-items"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <IconX id="close-icon" class="hidden size-6" />
      <IconMenuDeep id="menu-icon" class="size-6" />
    </button>
    <nav
      id="nav-menu"
      class="fixed inset-0 z-50 grid place-items-center bg-background/95 backdrop-blur transition-opacity duration-300 data-[open=false]:invisible data-[open=false]:pointer-events-none data-[open=false]:opacity-0 data-[open=true]:visible data-[open=true]:opacity-100"
      data-open="false"
      aria-hidden="true"
    >
      <div class="max-h-full w-full overflow-y-auto px-6 py-10 sm:px-10">
        <ul
          id="menu-items"
          class="mx-auto flex w-full max-w-md list-none flex-col gap-1.5 p-0 sm:max-w-lg"
        >
          <li class="menu-item" style="--d: 35ms">
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class:list={["menu-link", { "active-nav": isActive("/posts") }]}
            >
              {t.nav.posts}
            </a>
          </li>
          <li class="menu-item" style="--d: 70ms">
            <a
              href={getRelativeLocaleUrl(locale, "tags")}
              class:list={["menu-link", { "active-nav": isActive("/tags") }]}
            >
              {t.nav.tags}
            </a>
          </li>

          <li class="menu-item" style="--d: 105ms">
            <div class="flex w-full items-center justify-center gap-0.5">
              <a
                href={getRelativeLocaleUrl(locale, "publikasi")}
                class:list={[
                  "menu-link",
                  { "active-nav": isActive("/publikasi") },
                ]}
              >
                Publikasi
              </a>
              <button
                id="pubs-toggle"
                type="button"
                class="focus-outline flex size-11 shrink-0 items-center justify-center rounded-full text-foreground transition-colors hover:text-accent"
                aria-expanded="false"
                aria-controls="pubs-submenu"
                aria-label="Toggle publikasi submenu"
              >
                <svg
                  class="pubs-chevron size-5 transition-transform duration-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </div>
            <div
              id="pubs-submenu"
              class="dropdown"
              data-submenu
              data-open="false"
              aria-hidden="true"
            >
              <div class="dropdown-inner">
                <ul class="flex list-none flex-col gap-1 pt-1 pb-1">
                  <li>
                    <a
                      href={getRelativeLocaleUrl(locale, "paper")}
                      class:list={[
                        "submenu-link",
                        { "active-nav": isActive("/paper") },
                      ]}
                    >
                      Makalah
                    </a>
                  </li>
                  <li>
                    <a
                      href={getRelativeLocaleUrl(locale, "buku")}
                      class:list={[
                        "submenu-link",
                        { "active-nav": isActive("/buku") },
                      ]}
                    >
                      Buku
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </li>

          <li class="menu-item" style="--d: 140ms">
            <div class="flex w-full items-center justify-center gap-0.5">
              <a
                href={getRelativeLocaleUrl(locale, "apps")}
                class:list={[
                  "menu-link",
                  { "active-nav": isActive("/apps") },
                ]}
              >
                {t.nav.apps}
              </a>
              <button
                id="apps-toggle"
                type="button"
                class="focus-outline flex size-11 shrink-0 items-center justify-center rounded-full text-foreground transition-colors hover:text-accent"
                aria-expanded="false"
                aria-controls="apps-submenu"
                aria-label="Toggle apps submenu"
              >
                <svg
                  class="apps-chevron size-5 transition-transform duration-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </div>
            <div
              id="apps-submenu"
              class="dropdown"
              data-submenu
              data-open="false"
              aria-hidden="true"
            >
              <div class="dropdown-inner">
                <ul class="flex list-none flex-col gap-1 pt-1 pb-1">
                  <li>
                    <a
                      href="https://model.kanadakurniawan.com"
                      rel="noopener"
                      target="_blank"
                      class="submenu-link"
                    >
                      Model
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </li>

          <li class="menu-item" style="--d: 175ms">
            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class:list={["menu-link", { "active-nav": isActive("/about") }]}
            >
              {t.nav.about}
            </a>
          </li>
          {
            features.showArchives && (
              <li class="menu-item" style="--d: 210ms">
                <a
                  href={getRelativeLocaleUrl(locale, "archives")}
                  class:list={[
                    "menu-link",
                    { "active-nav": isActive("/archives") },
                  ]}
                >
                  {t.nav.archives}
                </a>
              </li>
            )
          }
          {
            features.search !== false && (
              <li class="menu-item" style="--d: 245ms">
                <a
                  href={getRelativeLocaleUrl(locale, "search")}
                  class:list={[
                    "menu-link",
                    { "active-nav": isActive("/search") },
                  ]}
                >
                  {t.nav.search}
                </a>
              </li>
            )
          }
          {
            features.lightAndDarkMode && (
              <li class="menu-item mt-5 flex justify-center" style="--d: 280ms">
                <button
                  id="theme-btn"
                  class="focus-outline relative flex size-14 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-accent hover:text-accent"
                  title={t.a11y.toggleTheme}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const navMenu = document.querySelector<HTMLElement>("#nav-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !navMenu || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    const setOpen = (open: boolean) => {
      navMenu.dataset.open = String(open);
      navMenu.setAttribute("aria-hidden", String(!open));
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";

      // Tutup semua submenu saat menu di-close (naik/di klik link).
      if (!open) {
        navMenu
          .querySelectorAll<HTMLElement>("[data-submenu]")
          .forEach((el) => {
            el.dataset.open = "false";
            el.setAttribute("aria-hidden", "true");
          });
        navMenu
          .querySelectorAll<HTMLButtonElement>("#pubs-toggle, #apps-toggle")
          .forEach((btn) => btn.setAttribute("aria-expanded", "false"));
      }
    };

    menuBtn.addEventListener("click", () => {
      setOpen(navMenu.dataset.open !== "true");
    });

    // Klik link mana pun → tutup menu.
    navMenu.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => setOpen(false))
    );

    // Klik area kosong overlay → tutup menu (bukan di link/button).
    navMenu.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest("a") && !target.closest("button")) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  function bindSubmenu(id: string) {
    const toggle = document.querySelector<HTMLButtonElement>(`#${id}-toggle`);
    const submenu = document.querySelector<HTMLElement>(`#${id}-submenu`);
    const chevron = document.querySelector<SVGElement>(`.${id}-chevron`);

    if (!toggle || !submenu || !chevron) return;

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      e.preventDefault();
      const open = submenu.dataset.open === "true";
      submenu.dataset.open = String(!open);
      submenu.setAttribute("aria-hidden", String(open));
      toggle.setAttribute("aria-expanded", String(!open));
      chevron.style.transform = open ? "" : "rotate(180deg)";
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", (e) => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  bindSubmenu("pubs");
  document.addEventListener("astro:after-swap", () => bindSubmenu("pubs"));

  bindSubmenu("apps");
  document.addEventListener("astro:after-swap", () => bindSubmenu("apps"));

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>

<style>
  #nav-menu {
    transition: opacity 0.3s ease, visibility 0.3s;
  }

  /* Stagger masuk menu: tiap item muncul bergantian saat dibuka */
  .menu-item {
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition: opacity 0.35s ease, transform 0.35s ease;
    transition-delay: 0ms;
  }
  #nav-menu[data-open="true"] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: var(--d, 0ms);
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1.25rem;
    border-radius: 9999px;
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease,
      transform 0.2s ease;
  }
  .menu-link:hover,
  .menu-link.active-nav {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .menu-link:hover {
    transform: translateY(-1px);
  }

  .submenu-link {
    display: block;
    width: 100%;
    padding: 0.55rem 1.25rem;
    border-radius: 9999px;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .submenu-link:hover,
  .submenu-link.active-nav {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  /* Submenu: gunakan grid 0fr -> 1fr agar tinggi ter- animasi */
  .dropdown {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition: grid-template-rows 0.4s ease, opacity 0.3s ease,
      visibility 0s 0.4s;
  }
  .dropdown-inner {
    overflow: hidden;
  }
  .dropdown[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition: grid-template-rows 0.4s ease, opacity 0.3s ease;
  }
</style>
