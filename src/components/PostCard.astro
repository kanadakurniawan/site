---
interface Props {
	title: string;
	description: string;
	pubDate: Date;
	href: string;
	categories?: string[];
	tags?: string[];
}

const { title, description, pubDate, href, categories = [], tags = [] } = Astro.props;
const date = pubDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<article class="post-card">
	<a href={href}>
		<h2>{title}</h2>
	</a>
	<time datetime={pubDate.toISOString()}>{date}</time>
	<p>{description}</p>
	<div class="meta">
		{categories.map((c) => <span class="category">{c}</span>)}
		{tags.map((t) => <span class="tag">{t}</span>)}
	</div>
</article>

<style>
	.post-card {
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--border);
	}
	.post-card h2 {
		margin: 0 0 0.25rem;
		font-size: 1.25rem;
	}
	.post-card time {
		color: var(--muted);
		font-size: 0.9rem;
	}
	.post-card p {
		margin: 0.5rem 0 0.6rem;
		color: var(--muted);
	}
	.meta {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.category,
	.tag {
		font-size: 0.75rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		color: var(--muted);
	}
	.category {
		background: var(--accent-soft);
		border-color: transparent;
	}
</style>