---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
---

<BaseLayout title="About" description="Tentang Kanada Kurniawan — peneliti AI dan meteorologi.">
	<div class="about-hero">
		<div class="avatar-wrap">
			<Avatar size={200} />
		</div>
		<div>
			<span class="eyebrow">About</span>
			<h1>Kanada Kurniawan</h1>
			<p class="lead">Peneliti di persimpangan kecerdasan buatan dan meteorologi.</p>
		</div>
	</div>

	<div class="content">
		<p>
			Saya mendalami <em>deep learning</em> untuk meteorologi. Di perbatasan AI dan sains
			atmosfer, saya mengembangkan model jaringan saraf untuk prakiraan cuaca dan hidrologi.
		</p>

		<h2>Pengalaman</h2>
		<div class="entry">
			<h3>Meteorology Officer</h3>
			<p class="org">BMKG — Stasiun Meteorologi Kelas III Maritim Dwikora, Pontianak</p>
			<p class="meta">Present</p>
		</div>

		<h2>Pendidikan</h2>
		<div class="entry">
			<h3>Magister Teknik (MT), Teknik Elektro (Artificial Intelligence)</h3>
			<p class="org">Universitas Tanjungpura</p>
			<p class="meta">2024 – 2026</p>
		</div>
		<div class="entry">
			<h3>Sarjana Ilmu Komputer</h3>
			<p class="org">Universitas Muhammadiyah Pontianak</p>
			<p class="meta">2020 – 2023</p>
		</div>
	</div>
</BaseLayout>

<style>
	.about-hero {
		display: flex;
		align-items: center;
		gap: 2.4rem;
		flex-wrap: wrap;
		margin-block: 3.5rem 2.75rem;
	}
	.avatar-wrap {
		flex-shrink: 0;
	}
	.about-hero h1 {
		margin: 0.5rem 0 0.35rem;
		font-weight: 620;
	}
	.lead {
		margin: 0;
	}
	.content {
		max-width: 46rem;
		font-size: 1.05rem;
	}
	.content > * + * {
		margin-top: 1.1rem;
	}
	h2 {
		margin-top: 2.4rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--border);
	}
	.entry {
		margin-block: 1.15rem;
	}
	.entry h3 {
		margin: 0;
		font-size: 1.08rem;
	}
	.org {
		margin: 0.15rem 0 0;
		color: var(--text);
		font-weight: 500;
	}
	.meta {
		margin: 0.15rem 0 0;
		color: var(--muted);
		font-size: 0.9rem;
		font-family: var(--mono);
	}
</style>