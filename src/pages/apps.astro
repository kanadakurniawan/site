---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const apps = await getEntry("pages", "apps");

if (!apps) {
  throw new Error(
    "Missing content entry: `apps.md` or `apps.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(apps);
---

<Layout
  title={`${apps.data.title} | ${config.site.title}`}
  description={apps.data.description}
  ogImage={apps.data.ogImage}
  canonicalURL={apps.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={apps.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
