---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Notes on artificial intelligence and meteorology research.">
	<header class="page-head">
		<span class="eyebrow">Blog</span>
		<h1>Catatan riset</h1>
		<p class="lead">Tulisan dan catatan tentang riset AI dan meteorologi.</p>
	</header>
	{
		posts.map((post) => (
			<PostCard
				title={post.data.title}
				description={post.data.description}
				pubDate={post.data.pubDate}
				href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
				categories={post.data.categories}
				tags={post.data.tags}
			/>
		))
	}
</BaseLayout>

<style>
	.page-head {
		margin-block: 3.5rem 2.5rem;
	}
	.page-head h1 {
		margin: 0.45rem 0 0.5rem;
	}
	.page-head .lead {
		margin: 0;
	}
</style>