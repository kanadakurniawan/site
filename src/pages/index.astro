---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Avatar from '../components/Avatar.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 5);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
	<section class="hero">
		<div class="avatar-wrap">
			<Avatar size={150} />
		</div>
		<div class="hero-copy">
			<span class="eyebrow">AI × Meteorology</span>
			<h1>{siteConfig.title}</h1>
			<p class="lead">{siteConfig.description}</p>
		</div>
	</section>

	<section class="writing">
		<div class="section-head">
			<h2>Latest writings</h2>
			<a class="btn-arrow" href={import.meta.env.BASE_URL + 'blog/'}>
				Semua tulisan <span class="arrow" aria-hidden="true">→</span>
			</a>
		</div>
		{
			latest.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
					categories={post.data.categories}
					tags={post.data.tags}
				/>
			))
		}
	</section>
</BaseLayout>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 2.2rem;
		flex-wrap: wrap;
		margin-block: 3.5rem 4rem;
	}
	.avatar-wrap {
		flex-shrink: 0;
	}
	.hero-copy {
		flex: 1;
		min-width: 260px;
	}
	.hero h1 {
		margin: 0.5rem 0 0.4rem;
		font-weight: 620;
	}
	.hero .lead {
		margin: 0;
	}
	.writing {
		margin-bottom: 1rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.6rem;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.5rem;
	}
</style>