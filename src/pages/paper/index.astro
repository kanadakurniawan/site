---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const papers = (await getCollection("paper")).sort(
  (a, b) => b.data.year - a.data.year
);
---

<Layout
  title={`Paper | ${config.site.title}`}
  description="Daftar publikasi jurnal & konferensi Kanada Kurniawan — AI dan meteorologi."
  ogImage={config.site.ogImage}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle="Paper" class="app-prose">
    <p>
      Daftar publikasi yang dapat dikutip (DOI tersedia). Karya lengkap juga ada di
      <a href="https://scholar.google.com/citations?user=lLQWmDAAAAAJ&amp;hl=en" rel="noopener"> Google Scholar</a>.
    </p>
    <ol>
      {
        papers.map((paper) => (
          <li style={{ marginBottom: "1.5rem" }}>
            <a
              href={`/paper/${paper.id}/`}
              class="text-accent text-lg font-medium no-underline decoration-dashed underline-offset-4 hover:underline"
            >
              <strong>{paper.data.title}</strong>
            </a>
            <span class="text-muted-foreground text-base block">
              {paper.data.venue}, {paper.data.year}
              {paper.data.doi && (
                <a href={`https://doi.org/${paper.data.doi}`} rel="noopener">
                  {" "}· DOI: {paper.data.doi}
                </a>
              )}
              {paper.data.url && (
                <a href={paper.data.url} rel="noopener">
                  {" "}· Tautan
                </a>
              )}
            </span>
          </li>
        ))
      }
    </ol>
  </Main>

  <Footer />
</Layout>
